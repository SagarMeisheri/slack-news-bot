# Google Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Search / Tool Providers (Optional)
PARALLEL_API_KEY=your_parallel_api_key
SARVAM_API_KEY=your_sarvam_api_key

# Observability (Optional)
POSTHOG_KEY=your_posthog_key
POSTHOG_HOST=https://us.i.posthog.com

# Slack Bolt Configuration (Required for Slack Bot)
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-Level Token for Socket Mode (xapp-... with connections:write scope)
SLACK_APP_TOKEN=xapp-your-app-token
# Signing Secret (from App Credentials)
SLACK_SIGNING_SECRET=your-slack-signing-secret
